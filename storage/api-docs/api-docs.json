                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Komunitas Developer Laravel"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Ruang diskusi backend developer dan gamer"
                                    },
                                    "icon_url": {
                                        "type": "string",
                                        "example": "https://example.com/icon.png"
                                    }
